# ---------------------------------------------------------------------------
# Vellora — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is git-ignored and must NEVER be committed.
#
# Everything prefixed with NEXT_PUBLIC_ is exposed to the browser.
# Never put a secret behind a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# Canonical, absolute URL of the deployed site. Used for metadata,
# Open Graph tags, canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL="https://vellora.example.com"

# Optional: Google Maps embed key. Vellora renders a styled static map by
# default, so this is only needed if you switch to a live embed.
# NEXT_PUBLIC_MAPS_EMBED_KEY=""

# Optional: analytics measurement id (Plausible, GA4, Fathom, ...)
# NEXT_PUBLIC_ANALYTICS_ID=""

# Optional: endpoint that receives contact / viewing-request submissions.
# Vellora's forms are frontend-only by default and simply simulate a request.
# Point this at your own API route, Formspree, Resend handler, or CRM webhook.
# FORM_ENDPOINT=""

# Optional: transactional email credentials for your own API route.
# These are SERVER-ONLY — do not add a NEXT_PUBLIC_ prefix.
# RESEND_API_KEY=""
# CONTACT_INBOX="enquiries@your-domain.com"

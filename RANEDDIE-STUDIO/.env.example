# =============================================================================
# Editime — RANEDDIE STUDIO
# Copy this file to `.env.local` and fill in the values you need.
#   cp .env.example .env.local
# Nothing here is required to run the app: with no keys set, the app runs the
# MockAIProvider in Demo Mode and every feature is still explorable.
# NEVER commit .env.local — it is git-ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# AI provider selection (server-side only)
# One of: mock | anthropic | openai
# Defaults to "mock" when unset.
# -----------------------------------------------------------------------------
AI_PROVIDER=mock

# -----------------------------------------------------------------------------
# Provider credentials — SERVER SIDE ONLY.
# These are read exclusively in `src/lib/ai/server/*` and in the /api/ai route.
# Do NOT prefix them with NEXT_PUBLIC_ — that would ship them to the browser.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional media-generation providers. Each has a documented adapter in
# API_INTEGRATION.md. Unset means the related capability reports
# "Requires API" in the UI instead of silently faking a result.
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=
FAL_API_KEY=

# -----------------------------------------------------------------------------
# Public, non-secret configuration (safe to expose to the browser)
# -----------------------------------------------------------------------------
# Shown in the UI to make the current mode unambiguous.
NEXT_PUBLIC_APP_NAME=Editime
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Starting AI credit balance for new local installs.
NEXT_PUBLIC_DEFAULT_AI_CREDITS=500

# -----------------------------------------------------------------------------
# Future backend services (not used by the MVP — see ARCHITECTURE.md)
# -----------------------------------------------------------------------------
# DATABASE_URL=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# RENDER_WORKER_URL=
# STRIPE_SECRET_KEY=
